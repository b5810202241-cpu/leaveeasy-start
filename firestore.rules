// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎขั้นต่ำของสัปดาห์ที่ 7: ต้องล็อกอินก่อน ถึงอ่าน/เขียนได้
// ยังไม่แยกสิทธิ์ตามบทบาท (employee/manager/hr) — นั่นคืองานของสัปดาห์ที่ 8
//
// วิธี publish: เปิด Firebase Console → Firestore Database → Rules
// → วางเนื้อหาไฟล์นี้ทับของเดิม → กด Publish (ต้องทำเองในคอนโซล ไม่มี CLI ตั้งค่าไว้ในเครื่องนี้)
// ─────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
